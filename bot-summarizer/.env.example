# ==== bot-summarizer — пример окружения ====
# Скопируйте в .env и заполните. .env НЕ попадает в git.

# Telegram (токен от @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Кастомный корень API (для обхода блокировки через Cloudflare Worker).
# Оставьте пустым при пиннинге IP (extra_hosts).
TELEGRAM_API_ROOT=

# ==== ИИ: GigaChat (Sber) ====
# Authorization key = base64("ClientID:ClientSecret") из личного кабинета Sber.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2

# Путь к файлу с сообщениями за текущий день (JSON)
DATA_FILE=/data/messages.json

# Фразы-триггеры запроса пересказа (через запятую)
TRIGGER_WORDS=что обсуждали,перескажи,о чём говорили,о чем говорили,кратко,итог,резюме

TZ=Europe/Moscow
