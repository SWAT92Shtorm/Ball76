# ==== Ball76 bot — пример окружения ====
# Скопируйте в .env и заполните. .env НЕ попадает в git.

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Кастомный корень API (для обхода блокировки через Cloudflare Worker).
# Оставьте пустым при прямом доступе / пиннинге IP.
TELEGRAM_API_ROOT=

# ==== ИИ: GigaChat (Sber) — единственный провайдер ====
# Authorization key = base64("ClientID:ClientSecret") из личного кабинета Sber.
# Получить: developers.sber.ru → GigaChat API → «Авторизационные данные».
GIGACHAT_AUTH_KEY=
# Область доступа: GIGACHAT_API_PERS (физлицо), GIGACHAT_API_B2B (бизнес), GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Единственная поддерживаемая модель
GIGACHAT_MODEL=GigaChat-2

# Ball76 API (внутри docker-сети — по имени сервиса, иначе через хост)
API_BASE_URL=http://node:8080

# Публичный адрес сайта (показывается пользователям в боте)
SITE_URL=https://ball76.duckdns.org

# PostgreSQL (внутри docker-сети)
DATABASE_URL=postgres://Ball76:ПАРОЛЬ@db:5432/Ball76

# Группы для рассылок (chat_id через запятую), необязательно
NOTIFY_GROUP_IDS=

# Настройки уведомлений
REMINDER_HOURS_BEFORE=3
GATHER_HOURS_BEFORE=24

# ИИ отвечает только когда его упомянули (@username) или ответили на его
# сообщение. false — ИИ снова отвечает на любой текст (в личке).
AI_ONLY_ON_MENTION=true

TZ=Europe/Moscow
